{
  "expo": {
    "name": "AI Fitness Tracker",
    "slug": "balyra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "balyra",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.balyra.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AI Fitness Tracker requires your location to map your outdoor runs and record pace.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "AI Fitness Tracker requires background location to track your route while your screen is locked.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "package": "com.balyra.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AI Fitness Tracker needs continuous location access to accurately track your runs and split times."
        }
      ],
      "expo-video"
    ]
  }
}
